{
  "title": "BMP.tn — CI/CD & DevOps",
  "uid": "bmp-cicd",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["bmp", "cicd", "devops"],
  "panels": [
    {
      "id": 1,
      "title": "Backend Status",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job=\"bmp-backend\"}", "legendFormat": "Backend" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] } }
    },
    {
      "id": 2,
      "title": "HTTP Requests / sec",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [{ "expr": "rate(bmp_http_requests_total[1m])", "legendFormat": "{{method}} {{route}} {{status_code}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3,
      "title": "P95 Response Time",
      "type": "timeseries",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(bmp_http_request_duration_seconds_bucket[5m]))", "legendFormat": "P95 latency" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "title": "Node.js Heap Used",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "bmp_backend_nodejs_heap_size_used_bytes", "legendFormat": "Heap Used" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "title": "Node.js Event Loop Lag",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "bmp_backend_nodejs_eventloop_lag_seconds", "legendFormat": "Event Loop Lag" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "Backend Process Memory (RSS)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "bmp_backend_process_resident_memory_bytes", "legendFormat": "RSS Memory" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7,
      "title": "HTTP Status Code Distribution",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status_code)(bmp_http_requests_total)", "legendFormat": "{{status_code}}" }]
    },
    {
      "id": 8,
      "title": "Active Handles",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 },
      "targets": [{ "expr": "bmp_backend_nodejs_active_handles_total", "legendFormat": "Active Handles" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 9,
      "title": "GC Duration",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 24, "w": 18, "h": 4 },
      "targets": [{ "expr": "rate(bmp_backend_nodejs_gc_duration_seconds_sum[1m])", "legendFormat": "GC {{kind}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
