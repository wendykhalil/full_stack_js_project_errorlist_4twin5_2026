# Backend env example
PORT=5000
MONGO_URI=mongodb+srv://...
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BMP.tn <no-reply@bmp.tn>"

# Twilio Verify (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional: emails that receive activity notifications (comma-separated)
NOTIFY_EMAILS=admin@bmp.tn

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ollama (local AI)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
